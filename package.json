{
    "name": "turbo-dev",
    "version": "0.1.0",
    "description": "Interactive TurboRepo workspace selector — run dev for specific packages",
    "bin": {
        "turbo-dev": "./dist/index.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format cjs --dts --clean",
        "dev": "tsup src/index.ts --format cjs --watch",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "turborepo",
        "monorepo",
        "cli",
        "workspace",
        "dev"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "commander": "^12.0.0",
        "fast-glob": "^3.3.0",
        "picocolors": "^1.0.0",
        "prompts": "^2.4.2",
        "yaml": "^2.4.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/prompts": "^2.4.0",
        "tsup": "^8.0.0",
        "typescript": "^5.4.0"
    }
}
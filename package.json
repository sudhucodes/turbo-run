{
    "name": "turbo-run",
    "version": "0.2.0",
    "description": "Interactive TurboRepo workspace selector — run dev for specific packages",
    "publishConfig": {
        "access": "public"
    },
    "bin": {
        "turbo-run": "./dist/index.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "changeset publish",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "turborepo",
        "monorepo",
        "cli",
        "workspace",
        "dev"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "commander": "^12.0.0",
        "fast-glob": "^3.3.0",
        "picocolors": "^1.0.0",
        "prompts": "^2.4.2",
        "yaml": "^2.4.0"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "@types/node": "^20.0.0",
        "@types/prompts": "^2.4.0",
        "prettier": "^3.8.3",
        "tsup": "^8.0.0",
        "typescript": "^5.4.0"
    }
}
